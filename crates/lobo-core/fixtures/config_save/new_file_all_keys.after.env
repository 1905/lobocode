# lobo config. Edit by hand or run `lobo config`.
# Keys here never go into a pod image or a release. Flags on `lobo up` override the defaults.
# Advanced keys (edit by hand): LOBO_POD_IMAGE (baked pod image, ghcr.io/1905/lobocode@sha256:…), LOBO_MODEL_SOURCE, LOBO_MODEL_SSH_KEY_FILE, LOBO_MODEL_SSH_HOSTKEY,
# LOBO_FEESH_HTTP_URL; R2_ACCOUNT_ID, R2_ACCESS_KEY, R2_SECRET_KEY, R2_ENDPOINT (fast presigned model
# download; `lobo release` needs them too).

# providers (at least one, or LOBO_PROVIDER=local)
RUNPOD_API_KEY=value
VASTAI_API_KEY=value

# access
LOBO_DOMAIN=value
LOBO_API_KEY=value
CF_TUNNEL_TOKEN=value
LOBO_BUCKET_URL=value

# defaults for `lobo up` (flags override; empty or 0 = built-in / release default)
LOBO_PROVIDER=value
LOBO_MIN_MBPS=value
LOBO_MODEL=value
LOBO_CTX=value
LOBO_IDLE_MIN=value
LOBO_MAX_HOURS=value
LOBO_CLOUD=value
LOBO_VAST_MAX_DPH=value
LOBO_WEIGHTS_DIR=value
LOBO_LOCAL_PORT=value
AA_EXTRA=a
ZZ_EXTRA=z
