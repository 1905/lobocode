# lobo config: copy to ~/.config/lobo/config.env (or run `lobo config`). The repo .env is only for `make release` / `make e2e`.
# RunPod API key (one provider key is enough)
RUNPOD_API_KEY=
# API key for the pod's llama-server + /api/logs
LOBO_API_KEY=
LOBO_DOMAIN=lobo.example.com
# Cloudflare tunnel token (from tunnel create)
CF_TUNNEL_TOKEN=
# Public r2.dev URL of bucket lobo
LOBO_BUCKET_URL=
# R2 S3 creds (yapper402-admin) - laptop-only, uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
# Model source: r2 (presigned, default when R2 keys are set, fastest) | ssh://lobo@host:22 (the model server) | empty = public bucket URL
LOBO_MODEL_SOURCE=
LOBO_MODEL_SSH_KEY_FILE=
LOBO_MODEL_SSH_HOSTKEY=
# model server nginx (secret path), fallback when R2 is slow
LOBO_FEESH_HTTP_URL=
# Drop a pod whose model download is slower than this (MB/s, checked after 20 s). Default 100.
LOBO_MIN_MBPS=
# Vast.ai API key (optional; enables --provider vast)
VASTAI_API_KEY=
# Max $/h for a Vast 5090 offer (default 1.20)
LOBO_VAST_MAX_DPH=
# Defaults for `lobo up` (flags override; empty = built-in)
# runpod | vast, used when both provider keys are set (default runpod)
LOBO_PROVIDER=
# q8 | q6 (default q8)
LOBO_MODEL=
# context tokens (default: release, 65536)
LOBO_CTX=
# minutes without requests before the pod deletes itself (default 30)
LOBO_IDLE_MIN=
# hard pod lifetime in hours (default 12)
LOBO_MAX_HOURS=
# runpod: community (default: community hosts only, cheapest) | secure (datacenter first, community fallback)
LOBO_CLOUD=
