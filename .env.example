# Rust app/CLI configuration. Run `lobo config` or copy to ~/.config/lobo/config.env.
# Set at least one GPU provider key.
RUNPOD_API_KEY=
VASTAI_API_KEY=
# API key for the model endpoint and agent logs.
LOBO_API_KEY=
# Private SSH is the default. The control API uses LOBO_CLOUD_PORT + 1.
LOBO_CONNECTION=ssh
LOBO_CLOUD_PORT=8933
# runpod | vast; prefer the configured provider, RunPod first.
LOBO_PROVIDER=
# The only supported model. Weights download on the GPU host.
LOBO_MODEL=qwen38-q6
LOBO_IMAGE_REPO=1905/lobocode
LOBO_MODEL_BASE_URL=https://models.stealthcopilot.io
# Context tokens, idle shutdown minutes, and maximum lifetime hours.
LOBO_CTX=65536
LOBO_IDLE_MIN=30
LOBO_MAX_HOURS=12
# RunPod: community | secure.
LOBO_CLOUD=community
# Minimum advertised Vast speed and measured model download speed, MB/s.
LOBO_MIN_MBPS=100
# Maximum Vast price, dollars per hour.
LOBO_VAST_MAX_DPH=1.20

# Optional legacy Cloudflare connection. Not required for SSH.
LOBO_DOMAIN=
CF_TUNNEL_TOKEN=

# Maintainer-only upload settings. Normal starts do not use them.
LOBO_BUCKET_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
